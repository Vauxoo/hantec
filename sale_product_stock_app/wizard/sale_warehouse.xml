<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="show_sale_order_stock_warehouse" model="ir.ui.view">
        <field name="name">sale.warehouse.form</field>
        <field name="model">sale.warehouse</field>
        <field name="arch" type="xml">
            <form>
                <h1>
                    <field name="product_id" readonly="1"/>
                </h1>
                <group string="Stock Informations">
                   <field name="stock_line" nolabel="1" readonly="1">
                        <tree editable="bottom">
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="available_qty"/>
                            <field name="on_hand"/>
                        </tree>
                   </field>
               </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_view_add_sale_stock_warehouser" model="ir.actions.act_window">
        <field name="name">Product's Stock Details</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.warehouse</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- <field name="context">{}</field> -->
    </record>

</odoo>